{
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		".godot/": true,
	},
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.expand": false,
	"explorer.fileNesting.patterns": {
		"*.cs": "${capture}.cs.uid",
		"*.gd": "${capture}.gd.uid",
		"*.svg": "${capture}.svg.import",
		"*.pmg": "${capture}.png.import",
		"project.godot": "*.sln,*.csproj"
	},
	"cSpell.words": [
		"ceili",
		"clampf",
		"clampi",
		"deadzone",
		"elif",
		"floorf",
		"floori",
		"lerp",
		"lerpf",
		"maxf",
		"maxi",
		"minf",
		"pgtk",
		"printerr",
		"randf",
		"snappedf",
		"subtween"
	],
}